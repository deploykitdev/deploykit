meta {
  name: Create Deployment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects/{{projectId}}/services/{{serviceId}}/deployments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "image": "nginx:latest",
    "env_vars": {
      "NODE_ENV": "production"
    },
    "ports": [
      {
        "container_port": 80,
        "host_port": 8081,
        "protocol": "tcp"
      }
    ],
    "replicas": 1
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("deploymentId", res.body.id);
  }
}
