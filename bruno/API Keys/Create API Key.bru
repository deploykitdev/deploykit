meta {
  name: Create API Key
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api-keys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "description": "Development API Key"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("apiKeyId", res.body.id);
  }
}
